# Dockerfile for marker-pdf server - CPU only
# GPU is freed for embedding/reranking services
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies for OCR and document processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-nor \
    poppler-utils \
    ghostscript \
    libmagic1 \
    libcairo2 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi8 \
    libjpeg62-turbo \
    libopenjp2-7 \
    libxml2 \
    libxslt1.1 \
    libfreetype6 \
    libharfbuzz0b \
    libglib2.0-0 \
    libfontconfig1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install PyTorch CPU-only first to avoid pulling CUDA dependencies
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install marker-pdf and server dependencies
RUN pip install --no-cache-dir "marker-pdf[full]" uvicorn fastapi python-multipart

COPY marker_proxy /app/marker_proxy

EXPOSE 8003

CMD ["uvicorn", "marker_proxy.app:app", "--host", "0.0.0.0", "--port", "8003"]
